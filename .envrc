#!/usr/bin/env bash

# Use nix-shell for development environment
use nix

# Load any local environment variables if they exist
if [[ -f .env.local ]]; then
  dotenv .env.local
fi

# Load .env files in order of priority
if [[ -f .env ]]; then
  dotenv .env
fi

# Print helpful information when environment loads
echo "✅ Environment loaded with Node.js and pnpm"
echo "   Run 'pnpm install' if this is your first time setting up" 